#!/usr/bin/make -f
# -*- makefile -*-
# This debian/rules uses debhelper.
#

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

DPKG_EXPORT_BUILDFLAGS = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -Wall
include /usr/share/dpkg/default.mk

override_dh_auto_configure:
	dh_auto_configure -- --prefix=/opt/vyatta --sysconfdir=/opt/vyatta/etc

# pkg.vyatta-security-vpn.vti-only builds only vyatta-interfaces-vti-v1-yang
# (NuDanOS 1.0: the OSPF, policy and TCP-MSS models import it). The VPN
# itself needs python3-vici, which comes with the strongswan rewrite (1.1).
ifneq (,$(filter pkg.vyatta-security-vpn.vti-only,$(DEB_BUILD_PROFILES)))
override_dh_auto_test:

override_dh_missing:
	dh_missing --list-missing
else
# verbose output of unittest logs
override_dh_auto_test:
	dh_auto_test -- VERBOSE=1
endif

%:
	dh $@ --with autoreconf,yang,vci,python3,config-package

override_dh_installsystemd:
	dh_installsystemd --name=vyatta-ipsec-rekey --no-start
	dh_installsystemd --name=vyatta-ike-sa-daemon --no-start
	dh_installsystemd --name=vyatta-strongswan-starter --no-start

